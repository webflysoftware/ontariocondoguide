{
  "name": "ontariocondoguide",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:api": "node server/index.mjs",
    "build": "astro build && pagefind --site dist",
    "build:api": "esbuild server/index.mjs --bundle --platform=node --format=esm --target=node22 --outfile=server-dist/index.mjs --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^6.4.7",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@pagefind/default-ui": "^1.3.0",
    "esbuild": "^0.28.1",
    "pagefind": "^1.3.0",
    "zod": "^3.24.2"
  }
}
