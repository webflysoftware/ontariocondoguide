---
import { getFormSchema, getAllFields } from '@forms';
import type { FormField, FormSection } from '@forms';

interface Props {
  slug: string;
  fillUrl: string;
  officialPdfUrl: string;
  officialSourceUrl: string;
}

const { slug, fillUrl, officialPdfUrl, officialSourceUrl } = Astro.props;
const schema = getFormSchema(slug);

if (!schema) {
  throw new Error(`FormFiller: no schema registered for slug "${slug}".`);
}

const inputClass =
  'mt-1 w-full rounded-md border border-border px-3 py-2 text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500';

function showWhenAttrs(field: FormField): Record<string, string> {
  if (!field.showWhen) return {};
  return {
    'data-show-when-field': field.showWhen.field,
    'data-show-when-equals': JSON.stringify(field.showWhen.equals),
  };
}

const advancedSections = new Set(
  schema.sections.filter((s: FormSection) => s.advanced).map((s: FormSection) => s.id),
);
const fieldCount = getAllFields(schema).length;
---

<div
  id="form-filler"
  data-slug={slug}
  data-fill-url={fillUrl}
  data-output-name={`${schema.outputFileName}.pdf`}
  class="not-prose"
>
  {schema.intro && (
    <p class="rounded-lg border border-brand-100 bg-brand-50 p-4 text-sm leading-6 text-slate-700">
      {schema.intro}
    </p>
  )}

  <form id="filler-form" novalidate class="mt-6 space-y-8">
    {
      schema.sections.map((section: FormSection) => {
        const fieldsMarkup = section.fields.map((field: FormField) => {
          const wrapperClasses = [
            'form-field',
            field.colSpan === 2 ? 'sm:col-span-2' : '',
          ]
            .filter(Boolean)
            .join(' ');

          const label = (
            <label for={`f-${field.id}`} class="block text-sm font-medium text-slate-900">
              {field.label}
              {field.required && <span class="ml-0.5 text-red-600" aria-hidden="true">*</span>}
            </label>
          );

          const guidance = field.guidance ? (
            <p class="mt-1 text-xs leading-5 text-slate-500">{field.guidance}</p>
          ) : null;

          const errorEl = (
            <p class="form-error mt-1 hidden text-xs font-medium text-red-600" data-error-for={field.id} />
          );

          let control;

          if (field.fixedValue !== undefined) {
            control = (
              <p class="mt-1 rounded-md bg-slate-50 px-3 py-2 text-sm text-slate-700">
                {field.fixedValue}
                <span class="ml-2 text-xs text-slate-400">(pre-filled)</span>
              </p>
            );
          } else if (field.type === 'textarea') {
            control = (
              <textarea
                id={`f-${field.id}`}
                name={field.id}
                rows={4}
                maxlength={field.maxLength}
                placeholder={field.placeholder}
                class={inputClass}
              />
            );
          } else if (field.type === 'select') {
            control = (
              <select id={`f-${field.id}`} name={field.id} class={inputClass}>
                <option value="">Select…</option>
                {field.options?.map((opt) => <option value={opt.value}>{opt.label}</option>)}
              </select>
            );
          } else if (field.type === 'radio') {
            control = (
              <div class="mt-2 space-y-2" role="radiogroup" aria-label={field.label}>
                {field.options?.map((opt) => (
                  <label class="flex items-start gap-2 text-sm text-slate-800">
                    <input
                      type="radio"
                      name={field.id}
                      id={`f-${field.id}-${opt.value}`}
                      value={opt.value}
                      class="mt-0.5 h-4 w-4 border-border text-brand-600 focus:ring-brand-500"
                    />
                    <span>{opt.label}</span>
                  </label>
                ))}
              </div>
            );
          } else if (field.type === 'checkbox') {
            control = (
              <label class="mt-2 flex items-start gap-2 text-sm text-slate-800">
                <input
                  type="checkbox"
                  name={field.id}
                  id={`f-${field.id}`}
                  value="true"
                  class="mt-0.5 h-4 w-4 rounded border-border text-brand-600 focus:ring-brand-500"
                />
                <span>{field.label}</span>
              </label>
            );
          } else if (field.type === 'checkbox-group') {
            control = (
              <div class="mt-2 grid gap-2 sm:grid-cols-2">
                {field.options?.map((opt) => (
                  <label class="flex items-start gap-2 text-sm text-slate-800">
                    <input
                      type="checkbox"
                      name={field.id}
                      id={`f-${field.id}-${opt.value}`}
                      value={opt.value}
                      class="mt-0.5 h-4 w-4 rounded border-border text-brand-600 focus:ring-brand-500"
                    />
                    <span>{opt.label}</span>
                  </label>
                ))}
              </div>
            );
          } else {
            control = (
              <input
                type={field.type}
                id={`f-${field.id}`}
                name={field.id}
                maxlength={field.maxLength}
                placeholder={field.placeholder}
                class={inputClass}
              />
            );
          }

          // `checkbox` renders its own label; others show the standalone label.
          const showStandaloneLabel = field.type !== 'checkbox';

          return (
            <div class={wrapperClasses} data-field={field.id} {...showWhenAttrs(field)}>
              {showStandaloneLabel && label}
              {control}
              {guidance}
              {errorEl}
            </div>
          );
        });

        const body = (
          <div class="grid gap-5 sm:grid-cols-2">{fieldsMarkup}</div>
        );

        if (advancedSections.has(section.id)) {
          return (
            <details class="rounded-xl border border-border bg-white">
              <summary class="cursor-pointer list-none rounded-xl px-5 py-4 text-base font-semibold text-slate-900 hover:bg-slate-50">
                <span class="inline-flex items-center gap-2">
                  <span aria-hidden="true">▸</span>
                  {section.title}
                  <span class="text-xs font-normal text-slate-500">(optional)</span>
                </span>
              </summary>
              <div class="border-t border-border px-5 py-5">
                {section.description && (
                  <p class="mb-4 text-sm leading-6 text-slate-600">{section.description}</p>
                )}
                {body}
              </div>
            </details>
          );
        }

        return (
          <section class="rounded-xl border border-border bg-white p-5 sm:p-6">
            <h2 class="text-base font-semibold text-slate-900">{section.title}</h2>
            {section.description && (
              <p class="mt-1 text-sm leading-6 text-slate-600">{section.description}</p>
            )}
            <div class="mt-4">{body}</div>
          </section>
        );
      })
    }

    {schema.signatureNote && (
      <p class="rounded-lg bg-amber-50 p-4 text-sm leading-6 text-amber-900">
        <span class="font-semibold">Before you submit:</span> {schema.signatureNote}
      </p>
    )}

    <p id="form-status" role="status" aria-live="polite" class="hidden text-sm font-medium" />
  </form>

  <!-- Sticky action bar: primary CTA always within thumb reach on mobile. -->
  <div
    class="sticky bottom-0 z-10 -mx-4 mt-8 border-t border-border bg-white/95 px-4 py-3 backdrop-blur sm:mx-0 sm:rounded-xl sm:border"
  >
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-slate-500">
        {fieldCount} fields · Generates a completed PDF to print &amp; sign.
      </p>
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
        <a
          href={officialPdfUrl}
          class="inline-flex items-center justify-center rounded-md border border-border px-4 py-2 text-sm font-medium text-slate-700 no-underline hover:bg-slate-50"
          download
        >
          Blank official PDF
        </a>
        <button
          type="submit"
          form="filler-form"
          id="filler-submit"
          class="inline-flex items-center justify-center rounded-md bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-60"
        >
          Download filled PDF
        </button>
      </div>
    </div>
  </div>

  <p class="mt-3 text-xs leading-5 text-slate-400">
    Your answers are sent to this site only to generate the PDF and are not stored. This is not
    legal advice — verify against the
    <a href={officialSourceUrl} class="underline" target="_blank" rel="noopener noreferrer">
      official form
    </a>
    before submitting to your corporation.
  </p>
</div>

<script>
  import { getFormSchema, getAllFields, isFieldVisible, validateForm } from '@forms';
  import type { FormAnswers, FormField } from '@forms';

  const root = document.getElementById('form-filler');
  const form = document.getElementById('filler-form') as HTMLFormElement | null;
  if (root && form) {
    const slug = root.dataset.slug ?? '';
    const fillUrl = root.dataset.fillUrl ?? '';
    const outputName = root.dataset.outputName ?? 'form.pdf';
    const schema = getFormSchema(slug);
    const submitBtn = document.getElementById('filler-submit') as HTMLButtonElement | null;
    const statusEl = document.getElementById('form-status');

    if (schema) {
      const fields = getAllFields(schema);

      const readField = (field: FormField): FormAnswers[string] => {
        if (field.fixedValue !== undefined) return field.fixedValue;
        if (field.type === 'checkbox') {
          const el = document.getElementById(`f-${field.id}`) as HTMLInputElement | null;
          return el?.checked ?? false;
        }
        if (field.type === 'checkbox-group') {
          return Array.from(
            form.querySelectorAll<HTMLInputElement>(`input[name="${field.id}"]:checked`),
          ).map((el) => el.value);
        }
        if (field.type === 'radio') {
          const el = form.querySelector<HTMLInputElement>(`input[name="${field.id}"]:checked`);
          return el?.value ?? '';
        }
        const el = document.getElementById(`f-${field.id}`) as
          | HTMLInputElement
          | HTMLTextAreaElement
          | HTMLSelectElement
          | null;
        return el?.value ?? '';
      };

      const collectAnswers = (): FormAnswers => {
        const answers: FormAnswers = {};
        for (const field of fields) answers[field.id] = readField(field);
        return answers;
      };

      const applyConditionalVisibility = () => {
        const answers = collectAnswers();
        for (const field of fields) {
          const wrapper = form.querySelector<HTMLElement>(`[data-field="${field.id}"]`);
          if (!wrapper || !wrapper.dataset.showWhenField) continue;
          wrapper.hidden = !isFieldVisible(field, answers);
        }
      };

      const clearErrors = () => {
        form.querySelectorAll<HTMLElement>('.form-error').forEach((el) => {
          el.textContent = '';
          el.classList.add('hidden');
        });
      };

      const setStatus = (message: string, tone: 'error' | 'success' | 'busy') => {
        if (!statusEl) return;
        statusEl.textContent = message;
        statusEl.classList.remove('hidden', 'text-red-600', 'text-green-700', 'text-slate-600');
        statusEl.classList.add(
          tone === 'error' ? 'text-red-600' : tone === 'success' ? 'text-green-700' : 'text-slate-600',
        );
      };

      const showErrors = (errors: { field: string; message: string }[]) => {
        clearErrors();
        for (const err of errors) {
          const el = form.querySelector<HTMLElement>(`[data-error-for="${err.field}"]`);
          if (el) {
            el.textContent = err.message;
            el.classList.remove('hidden');
          }
        }
        const first = errors[0];
        if (first) {
          const target = form.querySelector<HTMLElement>(`[data-field="${first.field}"]`);
          target?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          target?.querySelector<HTMLElement>('input, textarea, select')?.focus({ preventScroll: true });
        }
        setStatus(`Please fix ${errors.length} field${errors.length === 1 ? '' : 's'} above.`, 'error');
      };

      form.addEventListener('input', applyConditionalVisibility);
      form.addEventListener('change', applyConditionalVisibility);
      applyConditionalVisibility();

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        clearErrors();
        const answers = collectAnswers();

        const errors = validateForm(schema, answers);
        if (errors.length) {
          showErrors(errors);
          return;
        }

        if (submitBtn) submitBtn.disabled = true;
        setStatus('Generating your PDF…', 'busy');

        try {
          const res = await fetch(fillUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ answers }),
          });

          if (res.status === 422) {
            const data = (await res.json().catch(() => null)) as
              | { errors?: { field: string; message: string }[] }
              | null;
            showErrors(data?.errors ?? [{ field: fields[0].id, message: 'Validation failed.' }]);
            return;
          }

          if (!res.ok) {
            setStatus('Sorry — the PDF could not be generated. Please try again.', 'error');
            return;
          }

          const blob = await res.blob();
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = outputName;
          document.body.appendChild(a);
          a.click();
          a.remove();
          URL.revokeObjectURL(url);
          setStatus('Your filled PDF has downloaded. Print, sign, and deliver it as noted above.', 'success');
        } catch {
          setStatus('Network error — please check your connection and try again.', 'error');
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    }
  }
</script>
